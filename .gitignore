# build output
/bin/
/dist/

# runtime data should live under XDG dirs, but never commit stray copies
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# machine-specific Claude settings and legacy helper scripts
/.claude/settings.local.json
/.claude/helpers/

# legacy graph cache; Trail's cache is excluded by .trail/.gitignore
/graft/
