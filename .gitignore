# build output
/bin/
/dist/

# runtime data should live under XDG dirs, but never commit stray copies
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# local tooling state (machine-specific: graft bakes absolute paths into its hooks)
/.claude/settings.local.json
/.claude/settings.json
/.claude/helpers/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
